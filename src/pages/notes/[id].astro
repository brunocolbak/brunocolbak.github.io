---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { dateFr } from '../../lib';

export async function getStaticPaths() {
  const notes = await getCollection('notes', (n) => !n.data.brouillon);
  return notes.map((n) => ({ params: { id: n.id }, props: { n } }));
}
const { n } = Astro.props;
const { Content } = await render(n);
---
<Base titre={n.data.titre} description={n.data.resume}>
  <article>
    <p class="meta">{dateFr(n.data.date)}</p>
    <h1>{n.data.titre}</h1>
    <div class="texte"><Content /></div>
  </article>
</Base>
